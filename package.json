{
  "name": "qclod",
  "version": "0.2.1",
  "description": "Desktop shell for the Claude Code CLI",
  "main": "./out/main/index.js",
  "author": "SOJuse",
  "repository": {
    "type": "git",
    "url": "https://github.com/SOJuse/qclod.git"
  },
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:e2e": "electron-vite build --mode e2e",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test:unit": "vitest run",
    "test:e2e": "npm run build:e2e && playwright test",
    "check:seams": "node scripts/check-release-seams.mjs",
    "dist": "npm run icon && npm run art && npm run build && npm run check:seams && electron-builder --win --x64 --publish never",
    "release": "npm run icon && npm run art && npm run build && npm run check:seams && electron-builder --win --x64 --publish always",
    "dist:e2e": "npm run icon && npm run art && npm run build:e2e && electron-builder --win dir --x64 -c.directories.output=dist-e2e --publish never",
    "icon": "node scripts/make-icon.mjs",
    "art": "node scripts/make-installer-art.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.319",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "electron-updater": "6.3.9",
    "lucide-react": "1.62.0",
    "uqr": "0.1.3",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "jsdom": "25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "allowScripts": {
    "electron@33.4.11": true,
    "esbuild@0.21.5": true
  }
}
